func _ready() -> void:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--lang="):
			set_lang(arg.trim_prefix("--lang="))


func set_lang(code: String) -> void:
	if code == "en" or code == "es":
		lang = code
		chosen = true


func text(key: String) -> String:
	var pack: Dictionary = lines.get(lang, {})
	if pack.has(key):
		return str(pack[key])
	var more: Dictionary = circuit.get(lang, {})
	if more.has(key):
		return str(more[key])
	var fallback: Dictionary = lines["en"]
	if fallback.has(key):
		return str(fallback[key])
	var more_en: Dictionary = circuit["en"]
	if more_en.has(key):
		return str(more_en[key])
	return key


